# Copy to .env.local and adjust. Restart `npm run dev` after changing.
# Only public, non-secret values belong here (NEXT_PUBLIC_* is sent to the browser).
# Gemini keys and other secrets stay on the FastAPI backend.

# "mock" (default) uses demo data from src/data. "api" calls the backend.
NEXT_PUBLIC_DATA_MODE=mock

# FastAPI backend base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Show the Retry button on failed evaluations (needs a backend retry endpoint)
NEXT_PUBLIC_FEATURE_RETRY_EVALUATION=false
